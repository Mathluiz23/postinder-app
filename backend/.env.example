PORT=4000
DATABASE_URL=postgres://postinder:postinder@localhost:5433/postinder
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# IP LAN da máquina rodando o backend — usado para montar URLs de mídia
# servidas em /seed-media, para funcionar em dispositivos físicos na mesma rede.
PUBLIC_HOST=http://192.168.1.13:4000
